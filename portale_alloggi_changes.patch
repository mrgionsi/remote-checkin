+        font-size: 1.25rem;
+        color: var(--primary-color);
+        transition: all 0.3s ease;
+    }
+
+    .section-title {
+        margin: 0;
+        font-size: 1rem;
+        font-weight: 600;
+        color: var(--text-color);
+        text-transform: uppercase;
+        letter-spacing: 0.05em;
+    }
+
+    &:hover {
+        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
+
+        .section-icon {
+            transform: scale(1.1);
+        }
+    }
+}
+
+.section-content {
+    padding: 1rem;
+    background: #ffffff;
+
+    .grid {
+        margin: 0;
+    }
+
+    .field {
+        margin-bottom: 0.75rem;
+
+        &:last-child {
+            margin-bottom: 0;
+        }
+
+        label {
+            font-weight: 500;
+            color: var(--text-color);
+            margin-bottom: 0.25rem;
+            display: block;
+            font-size: 0.8rem;
+            text-transform: uppercase;
+            letter-spacing: 0.025em;
+        }
+
+        input,
+        p-select,
+        p-datePicker {
+            transition: all 0.3s ease;
+            border-radius: 6px;
+
+            &:focus {
+                box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb), 0.1);
+                border-color: var(--primary-color);
+            }
+        }
+
+        // Ensure select dropdowns are visible
+        p-select {
+            ::ng-deep .p-select-overlay {
+                z-index: 1000 !important;
+            }
+        }
+
+        // Ensure date picker dropdowns are visible
+        p-datePicker {
+            ::ng-deep .p-datepicker {
+                z-index: 1000 !important;
+            }
+        }
+
+        .p-error {
+            margin-top: 0.25rem;
+            font-size: 0.7rem;
+            font-weight: 500;
+        }
+    }
+}
+
+// Enhanced field spacing for better visual hierarchy
+.p-fluid {
+    .form-section {
+        .field {
+            padding: 0.5rem 0;
+            border-radius: 6px;
+            transition: all 0.2s ease;
+
+            &:hover {
+                background: rgba(var(--primary-color-rgb), 0.02);
+                padding-left: 0.25rem;
+            }
+
+            label {
+                transition: all 0.2s ease;
+            }
+
+            &:focus-within {
+                label {
+                    color: var(--primary-color);
+                    font-weight: 600;
+                }
+            }
+        }
+    }
+}
+
+// Responsive adjustments for form sections
+@media (max-width: 768px) {
+    .form-section {
+        margin-bottom: 0.75rem;
+        border-radius: 6px;
+
+        .section-header {
+            padding: 0.5rem 0.75rem;
