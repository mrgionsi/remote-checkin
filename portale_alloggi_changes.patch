+    border-color: #3b82f6;
+    background: #f8fafc;
+    transform: translateY(-2px);
+    box-shadow: 0 8px 25px rgba(59, 130, 246, 0.15);
+  }
+
+  &.uploaded {
+    border-color: #10b981;
+    background: #f0fdf4;
+    border-style: solid;
+  }
+
+  &.error {
+    border-color: #ef4444;
+    background: #fef2f2;
+    animation: shake 0.5s ease-in-out;
+  }
+}
+
+@keyframes shake {
+
+    0%,
+    100% {
+        transform: translateX(0);
+    }
+
+    25% {
+        transform: translateX(-5px);
+    }
+
+    75% {
+        transform: translateX(5px);
+    }
+}
+
+// Upload Header
+.upload-header {
+    margin-bottom: 1rem;
+
+    i {
+        display: block;
+        margin: 0 auto 0.5rem;
+    }
+
+    h3 {
+        color: #1f2937;
+        margin-bottom: 0.25rem;
+    }
+
+    p {
+        color: #6b7280;
+        line-height: 1.4;
+    }
+}
+
+// Upload Area
+.upload-area {
+    flex: 1;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    min-height: 120px;
+}
+
+.upload-button {
+    width: 100%;
+    height: 100%;
+
+    ::ng-deep .p-fileupload-buttonbar {
+        display: none;
+    }
+
+    ::ng-deep .p-fileupload-content {
+        border: none;
+        padding: 0;
+    }
+
+    ::ng-deep .p-button {
+        width: 100%;
+        height: 100%;
+        background: transparent;
+        border: none;
+        padding: 0;
+
+        &:hover {
+            background: transparent;
+        }
+    }
+}
+
+.upload-placeholder {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  padding: 2rem;
+  border: 2px dashed #d1d5db;
+  border-radius: 8px;
+  background: #fafbfc;
+  transition: all 0.3s ease;
+  cursor: pointer;
+  min-height: 120px;
+  
+  &:hover {
+    border-color: #3b82f6;
+    background: #eff6ff;
+    
+    i {
+      color: #3b82f6 !important;
+    }
+  }
+}
+
+// Image Preview
+.image-preview-container {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+}
+
+.preview-header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    margin-bottom: 0.75rem;
+
+    span {
+        display: flex;
+        align-items: center;
+    }
+}
+
+.preview-image {
+    width: 100%;
+    height: 200px;
+    object-fit: cover;
+    border-radius: 8px;
+    border: 2px solid #e5e7eb;
+    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
+    transition: all 0.3s ease;
+
+    &:hover {
+        transform: scale(1.02);
+        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.15);
+    }
+}
+
+// Progress Bar
+.upload-progress {
+  background: #fafbfc;
+  border: 1px solid #e2e8f0;
+  border-radius: 8px;
+  padding: 1rem;
+
+    ::ng-deep .p-progressbar {
+        height: 8px;
+        border-radius: 4px;
+        background: #e2e8f0;
+
+        .p-progressbar-value {
+            background: linear-gradient(90deg, #3b82f6, #10b981);
+            border-radius: 4px;
+        }
+    }
+}
+
+// Responsive Design
+@media (max-width: 768px) {
+    .upload-container {
+        padding: 1rem;
+    }
+
+    .upload-card {
+        min-height: 250px;
+        padding: 1rem;
+    }
+
+    .preview-image {
+        height: 150px;
+    }
+}
+
+// Dark mode support
+@media (prefers-color-scheme: dark) {
+    .upload-card {
+        background: #1f2937;
+        border-color: #374151;
+        color: #f9fafb;
+
+        &:hover {
+            background: #111827;
+            border-color: #3b82f6;
+        }
+
+        &.uploaded {
+            background: #064e3b;
+            border-color: #10b981;
+        }
+
+        &.error {
+            background: #7f1d1d;
+            border-color: #ef4444;
+        }
+    }
+
+    .upload-header {
+        h3 {
+            color: #f9fafb;
+        }
+
+        p {
+            color: #d1d5db;
+        }
+    }
+
+    .upload-placeholder {
+        background: #374151;
+        border-color: #4b5563;
+        color: #d1d5db;
+
+        &:hover {
+            background: #1e3a8a;
+            border-color: #3b82f6;
+        }
+    }
+
+    .preview-image {
+        border-color: #4b5563;
+    }
+
+    .upload-progress {
+        background: #374151;
+        border-color: #4b5563;
+    }
 }
