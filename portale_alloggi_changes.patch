+        'mail_use_tls': True,
+        'mail_use_ssl': False,
+        'instructions': 'Use App Password for Yahoo accounts.'
+    },
+    'mailgun': {
+        'name': 'Mailgun',
+        'mail_server': 'smtp.mailgun.org',
