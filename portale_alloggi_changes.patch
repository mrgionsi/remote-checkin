diff --git a/frontend/src/app/pipes/date-short.pipe.ts b/frontend/src/app/pipes/date-short.pipe.ts
new file mode 100644
index 0000000..7a6002e
--- /dev/null
+++ b/frontend/src/app/pipes/date-short.pipe.ts
@@ -0,0 +1,20 @@
+import { Pipe, PipeTransform } from '@angular/core';
+
+@Pipe({
+  name: 'dateShort'
+})
+export class DateShortPipe implements PipeTransform {
+
+  transform(value: string | Date): string {
+    const date = new Date(value);
+    const day = this.padZero(date.getDate());
+    const month = this.padZero(date.getMonth() + 1); // Months are 0-based
+    const year = date.getFullYear();
+
+    return `${day}-${month}-${year}`;
+  }
+
+  private padZero(n: number): string {
+    return n < 10 ? '0' + n : '' + n;
+  }
+}
